@{
    ViewData["Title"] = "Exceptions Inbox";
}

<div class="card shadow-sm">
    <div class="card-header">Inbox</div>
    <div class="card-body">
        <table class="table">
            <thead>
            <tr>
                <th>Exception</th>
                <th>Project</th>
                <th>Priority</th>
                <th>Status</th>
            </tr>
            </thead>
            <tbody>
            <tr>
                <td>Duplicate allowance</td>
                <td>Payroll Oversight</td>
                <td><span class="badge bg-danger">High</span></td>
                <td><span class="badge bg-warning text-dark">New</span></td>
            </tr>
            <tr>
                <td>Missing approval</td>
                <td>Budget Tabulation</td>
                <td><span class="badge bg-warning text-dark">Medium</span></td>
                <td><span class="badge bg-info">In Review</span></td>
            </tr>
            </tbody>
        </table>
    </div>
</div>
