@using System.Globalization
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@{
    var isRtl = CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    var dir = isRtl ? "rtl" : "ltr";
}
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" dir="@dir">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Localizer["AppTitle"] - Ultra Audit Services (UAS)</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@sweetalert2/theme-bootstrap-4@5/bootstrap-4.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    @if (isRtl)
    {
        <link rel="stylesheet" href="~/css/rtl.css" />
    }
</head>
<body class="bg-light">
<div class="d-flex" id="layout-wrapper">
    <aside class="sidebar bg-dark text-white">
        <div class="p-3 border-bottom border-secondary">
            <div class="fw-bold">Ultra Audit Services</div>
            <small class="text-secondary">UAS</small>
        </div>
        <nav class="nav flex-column p-2">
            <div class="text-uppercase text-secondary small px-3 mt-3">Dashboard</div>
            <a class="nav-link text-white" asp-controller="Home" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i>Overview</a>
            <a class="nav-link text-white" asp-controller="Home" asp-action="MyTasks"><i class="bi bi-check2-square me-2"></i>My Tasks</a>
            <a class="nav-link text-white" asp-controller="Home" asp-action="RecentActivity"><i class="bi bi-clock-history me-2"></i>Recent Activity</a>

            <div class="text-uppercase text-secondary small px-3 mt-3">Projects</div>
            <a class="nav-link text-white" asp-controller="Projects" asp-action="Index"><i class="bi bi-briefcase me-2"></i>Projects List</a>
            <a class="nav-link text-white" asp-controller="Projects" asp-action="Create"><i class="bi bi-plus-circle me-2"></i>Create Project</a>
            <a class="nav-link text-white" asp-controller="Projects" asp-action="Teams"><i class="bi bi-people me-2"></i>Teams &amp; Members</a>
            <a class="nav-link text-white" asp-controller="Projects" asp-action="Risks"><i class="bi bi-shield-check me-2"></i>Risks &amp; Procedures Library</a>

            <div class="text-uppercase text-secondary small px-3 mt-3">Data</div>
            <a class="nav-link text-white" asp-controller="Data" asp-action="ImportWizard"><i class="bi bi-cloud-upload me-2"></i>Import Wizard</a>
            <a class="nav-link text-white" asp-controller="Data" asp-action="Datasets"><i class="bi bi-database me-2"></i>Datasets</a>
            <a class="nav-link text-white" asp-controller="Data" asp-action="Dictionary"><i class="bi bi-journal-text me-2"></i>Data Dictionary</a>
            <a class="nav-link text-white" asp-controller="Data" asp-action="Quality"><i class="bi bi-activity me-2"></i>Data Quality</a>

            <div class="text-uppercase text-secondary small px-3 mt-3">Analytics</div>
            <a class="nav-link text-white" asp-controller="Analytics" asp-action="Builder"><i class="bi bi-diagram-3 me-2"></i>Analysis Builder</a>
            <a class="nav-link text-white" asp-controller="Analytics" asp-action="Library"><i class="bi bi-collection me-2"></i>Analyses Library</a>
            <a class="nav-link text-white" asp-controller="Analytics" asp-action="Runs"><i class="bi bi-play-circle me-2"></i>Analysis Runs</a>
            <a class="nav-link text-white" asp-controller="Analytics" asp-action="Results"><i class="bi bi-graph-up me-2"></i>Results Explorer</a>
            <a class="nav-link text-white" asp-controller="Analytics" asp-action="Automation"><i class="bi bi-robot me-2"></i>Scripts &amp; Automation</a>

            <div class="text-uppercase text-secondary small px-3 mt-3">Exceptions (Findings)</div>
            <a class="nav-link text-white" asp-controller="Exceptions" asp-action="Inbox"><i class="bi bi-inbox me-2"></i>Exceptions Inbox</a>
            <a class="nav-link text-white" asp-controller="Exceptions" asp-action="Assignments"><i class="bi bi-person-check me-2"></i>Assignments</a>
            <a class="nav-link text-white" asp-controller="Exceptions" asp-action="Sla"><i class="bi bi-alarm me-2"></i>SLA &amp; Due Dates</a>
            <a class="nav-link text-white" asp-controller="Exceptions" asp-action="Comments"><i class="bi bi-chat-left-dots me-2"></i>Comments &amp; Evidence</a>

            <div class="text-uppercase text-secondary small px-3 mt-3">Working Papers</div>
            <a class="nav-link text-white" asp-controller="WorkingPapers" asp-action="Library"><i class="bi bi-folder2-open me-2"></i>Working Papers Library</a>
            <a class="nav-link text-white" asp-controller="WorkingPapers" asp-action="Reviews"><i class="bi bi-clipboard-check me-2"></i>Review &amp; Approvals</a>
            <a class="nav-link text-white" asp-controller="WorkingPapers" asp-action="Evidence"><i class="bi bi-paperclip me-2"></i>Evidence Repository</a>

            <div class="text-uppercase text-secondary small px-3 mt-3">Reports</div>
            <a class="nav-link text-white" asp-controller="Reports" asp-action="Templates"><i class="bi bi-file-earmark-text me-2"></i>Report Templates</a>
            <a class="nav-link text-white" asp-controller="Reports" asp-action="Generate"><i class="bi bi-file-earmark-arrow-down me-2"></i>Generate Reports</a>
            <a class="nav-link text-white" asp-controller="Reports" asp-action="ExportCenter"><i class="bi bi-box-arrow-up me-2"></i>Export Center</a>

            <div class="text-uppercase text-secondary small px-3 mt-3">AI Insights</div>
            <a class="nav-link text-white" asp-controller="AI" asp-action="DatasetInsights"><i class="bi bi-brain me-2"></i>Dataset Insights</a>
            <a class="nav-link text-white" asp-controller="AI" asp-action="RunInsights"><i class="bi bi-lightbulb me-2"></i>Run Insights</a>
            <a class="nav-link text-white" asp-controller="AI" asp-action="RiskScoring"><i class="bi bi-bar-chart-line me-2"></i>Risk Scoring</a>
            <a class="nav-link text-white" asp-controller="AI" asp-action="AnomalyExplorer"><i class="bi bi-exclamation-diamond me-2"></i>Anomaly Explorer</a>
            <a class="nav-link text-white" asp-controller="AI" asp-action="Similarity"><i class="bi bi-intersect me-2"></i>Similarity / Fuzzy Matching</a>

            <div class="text-uppercase text-secondary small px-3 mt-3">Administration</div>
            <a class="nav-link text-white" asp-controller="Administration" asp-action="UsersRoles"><i class="bi bi-person-gear me-2"></i>Users &amp; Roles</a>
            <a class="nav-link text-white" asp-controller="Administration" asp-action="Permissions"><i class="bi bi-key me-2"></i>Permissions Catalog</a>
            <a class="nav-link text-white" asp-controller="Administration" asp-action="AclManager"><i class="bi bi-shield-lock me-2"></i>ACL Manager</a>
            <a class="nav-link text-white" asp-controller="Administration" asp-action="AuditTrail"><i class="bi bi-journal-check me-2"></i>Audit Trail</a>
            <a class="nav-link text-white" asp-controller="Administration" asp-action="Settings"><i class="bi bi-sliders me-2"></i>System Settings</a>
            <a class="nav-link text-white" asp-controller="Administration" asp-action="Jobs"><i class="bi bi-hdd-network me-2"></i>Jobs Monitor</a>
        </nav>
    </aside>

    <div class="flex-grow-1">
        <header class="topbar border-bottom bg-white">
            <div class="container-fluid py-2 d-flex align-items-center justify-content-between">
                <div>
                    <button class="btn btn-outline-secondary btn-sm" id="command-palette-btn"><i class="bi bi-command"></i> Ctrl+K</button>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <form asp-controller="Account" asp-action="SetLanguage" method="post" class="d-flex align-items-center">
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                        <select name="culture" class="form-select form-select-sm" onchange="this.form.submit()">
                            <option value="en-US">English</option>
                            <option value="ar">العربية</option>
                        </select>
                    </form>
                    <div class="avatar bg-primary text-white">AU</div>
                </div>
            </div>
        </header>
        <main class="container-fluid p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h1 class="h4">@ViewData["Title"]</h1>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                            <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
                        </ol>
                    </nav>
                </div>
            </div>
            @RenderBody()
        </main>
        <footer class="footer border-top p-3 text-muted text-center">
            © 2024 Ultra Audit Services (UAS) — Government Audit Analytics Suite
        </footer>
    </div>
</div>

<div class="modal fade" id="commandPalette" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Command Palette</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="text" class="form-control mb-3" placeholder="Search commands or pages..." />
                <div class="list-group">
                    <a class="list-group-item list-group-item-action" asp-controller="Analytics" asp-action="Builder">Open Analysis Builder</a>
                    <a class="list-group-item list-group-item-action" asp-controller="Data" asp-action="ImportWizard">Open Import Wizard</a>
                    <a class="list-group-item list-group-item-action" asp-controller="Analytics" asp-action="Results">Open Results Explorer</a>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="~/js/site.js"></script>
@RenderSection("Scripts", required: false)
</body>
</html>
