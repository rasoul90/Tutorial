@{
    ViewData["Title"] = "Risk Scoring";
}

<div class="card shadow-sm">
    <div class="card-header">Risk Scores</div>
    <div class="card-body">
        <table class="table">
            <thead>
            <tr>
                <th>Entity</th>
                <th>Score</th>
                <th>Level</th>
            </tr>
            </thead>
            <tbody>
            <tr>
                <td>Vendor 1021</td>
                <td>0.88</td>
                <td><span class="badge bg-danger">High</span></td>
            </tr>
            <tr>
                <td>Employee 3342</td>
                <td>0.65</td>
                <td><span class="badge bg-warning text-dark">Medium</span></td>
            </tr>
            </tbody>
        </table>
    </div>
</div>
