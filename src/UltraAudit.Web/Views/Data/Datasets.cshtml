@{
    ViewData["Title"] = "Datasets";
}

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <div class="row g-2">
            <div class="col-md-4">
                <input class="form-control" placeholder="Search datasets" />
            </div>
            <div class="col-md-4">
                <select class="form-select">
                    <option>Saved Views</option>
                    <option>Payroll Quality</option>
                    <option>Budget Exceptions</option>
                </select>
            </div>
            <div class="col-md-4 text-end">
                <button class="btn btn-outline-secondary">Column Chooser</button>
                <button class="btn btn-outline-secondary">Advanced Filters</button>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header">Dataset Browser</div>
    <div class="card-body">
        <table class="table table-hover">
            <thead>
            <tr>
                <th>Name</th>
                <th>Source</th>
                <th>Rows</th>
                <th>Status</th>
            </tr>
            </thead>
            <tbody>
            <tr>
                <td>Payroll Dataset</td>
                <td>CSV</td>
                <td>1,200</td>
                <td><span class="badge bg-success">Validated</span></td>
            </tr>
            <tr>
                <td>Budget Tabulation</td>
                <td>Excel</td>
                <td>450</td>
                <td><span class="badge bg-warning text-dark">Review</span></td>
            </tr>
            </tbody>
        </table>
        <nav>
            <ul class="pagination">
                <li class="page-item disabled"><span class="page-link">Previous</span></li>
                <li class="page-item active"><span class="page-link">1</span></li>
                <li class="page-item"><a class="page-link" href="#">2</a></li>
                <li class="page-item"><a class="page-link" href="#">Next</a></li>
            </ul>
        </nav>
    </div>
</div>
