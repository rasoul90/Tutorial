@{
    ViewData["Title"] = "Import Wizard";
}

<div class="card shadow-sm">
    <div class="card-header">Import Wizard</div>
    <div class="card-body">
        <ol class="list-group list-group-numbered">
            <li class="list-group-item">Upload file (CSV/Excel/TXT)</li>
            <li class="list-group-item">Map headers &amp; detect encoding</li>
            <li class="list-group-item">Validate data types &amp; cleansing rules</li>
            <li class="list-group-item">Preview &amp; confirm import</li>
        </ol>
        <div class="mt-3">
            <button class="btn btn-primary">Start Import</button>
        </div>
    </div>
</div>
