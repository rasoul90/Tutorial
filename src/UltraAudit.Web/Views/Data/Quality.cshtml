@{
    ViewData["Title"] = "Data Quality";
}

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <h6 class="text-muted">Missing Values</h6>
                <div class="display-6">1.2%</div>
