    </div>
    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <h6 class="text-muted">Type Issues</h6>
                <div class="display-6">18</div>
                <small class="text-info">Date formats</small>
            </div>
        </div>
    </div>
