@{
    ViewData["Title"] = "Working Papers Library";
}

<div class="card shadow-sm">
    <div class="card-header">Working Papers</div>
    <div class="card-body">
        <table class="table table-hover">
            <thead>
            <tr>
                <th>Title</th>
                <th>Status</th>
                <th>Owner</th>
            </tr>
            </thead>
            <tbody>
            <tr>
                <td>Payroll Controls</td>
                <td><span class="badge bg-info">In Review</span></td>
                <td>A. Salem</td>
            </tr>
            <tr>
                <td>Budget Compliance</td>
                <td><span class="badge bg-warning text-dark">Draft</span></td>
                <td>M. Nasser</td>
            </tr>
            </tbody>
        </table>
    </div>
</div>
