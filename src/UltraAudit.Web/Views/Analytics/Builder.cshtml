@{
    ViewData["Title"] = "Analysis Builder";
}

<div class="card shadow-sm mb-3">
    <div class="card-header">Analysis Builder Stepper</div>
    <div class="card-body">
        <div class="d-flex justify-content-between">
            <div class="step active">1. Select Dataset</div>
            <div class="step">2. Choose Commands</div>
            <div class="step">3. Review &amp; Save</div>
            <div class="step">4. Run Analysis</div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-header">Command Catalog</div>
            <div class="card-body">
                <input class="form-control mb-2" placeholder="Search commands" />
                <div class="list-group">
                    <button class="list-group-item list-group-item-action">Benford</button>
                    <button class="list-group-item list-group-item-action">Duplicates</button>
                    <button class="list-group-item list-group-item-action">Stratify</button>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header">Pipeline</div>
            <div class="card-body">
                <ol class="list-group list-group-numbered">
                    <li class="list-group-item">Filter: Payroll = Active</li>
                    <li class="list-group-item">Benford: First Digit</li>
                    <li class="list-group-item">Export Results to Excel</li>
                </ol>
                <div class="mt-3">
                    <button class="btn btn-primary">Save Analysis</button>
                    <button class="btn btn-outline-secondary">Run Now</button>
                </div>
            </div>
        </div>
    </div>
</div>
