@{
    ViewData["Title"] = "Overview";
}

<div class="row g-3">
    <div class="col-md-3">
        <div class="card card-metric shadow-sm">
            <div class="card-body">
                <div class="text-muted">Active Projects</div>
                <div class="display-6">12</div>
                <small class="text-success">+2 this month</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-metric shadow-sm">
            <div class="card-body">
                <div class="text-muted">Datasets Ingested</div>
                <div class="display-6">48</div>
                <small class="text-info">Payroll &amp; Budget</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-metric shadow-sm">
            <div class="card-body">
                <div class="text-muted">Open Exceptions</div>
                <div class="display-6">27</div>
                <small class="text-warning">8 nearing SLA</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-metric shadow-sm">
            <div class="card-body">
                <div class="text-muted">Analysis Runs</div>
                <div class="display-6">134</div>
                <small class="text-success">98% success</small>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mt-3">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Recent Activity</span>
                <button class="btn btn-outline-primary btn-sm">View All</button>
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item">Payroll dataset imported with 1,200 rows.</li>
                    <li class="list-group-item">Benford analysis flagged 12 anomalies.</li>
                    <li class="list-group-item">Working paper "Budget Controls" submitted for review.</li>
                </ul>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-header">My Tasks</div>
            <div class="card-body">
                <span class="badge bg-warning text-dark">3 Pending Reviews</span>
                <div class="mt-3">
                    <div class="d-flex justify-content-between">
                        <span>Exception SLA Alerts</span>
                        <span>5</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span>Dataset Validation</span>
                        <span>2</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
