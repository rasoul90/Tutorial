<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DeliverySaaS</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" integrity="sha384-TMJo0C5ho5fww5DqmqW7FZYwl39GQYhEqN2w7Yt9RbQfPb0zQ4N6v6Q2Qok9mQv0" crossorigin="anonymous">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <header class="navbar navbar-expand-lg navbar-dark bg-primary mb-4">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">منصة إدارة التوصيل</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="تبديل القائمة">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item"><a class="nav-link" href="/Dashboards/SaasAdmin">لوحة أدمن SaaS</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Dashboards/CompanyAdmin">لوحة مدير الشركة</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Dashboards/BranchUser">لوحة الفرع</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Orders">الطلبات</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Problems">المشاكل</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Accounting/Settlements">المحاسبة</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Integration">التكامل</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Printing">الطباعة</a></li>
                </ul>
            </div>
        </div>
    </header>

    <main class="container pb-4">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
