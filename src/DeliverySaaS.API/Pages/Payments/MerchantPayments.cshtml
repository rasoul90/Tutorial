@page
@using System.Globalization
@{
    ViewData["Title"] = "دفعات التجار";
    var iqd = CultureInfo.GetCultureInfo("ar-IQ");
    string Iqd(decimal value) => string.Format(iqd, "{0:C}", value);
}

<h2 class="mb-3">دفعات التجار</h2>
<div class="card shadow-sm mb-3"><div class="card-body">
    <div class="row g-2">
        <div class="col-md-4"><label class="form-label">التاجر</label><input class="form-control" placeholder="معرف التاجر" /></div>
        <div class="col-md-2"><label class="form-label">المبلغ</label><input class="form-control" /></div>
        <div class="col-md-2"><label class="form-label">الطريقة</label><select class="form-select"><option>Courier</option><option>InPerson</option><option>ETransfer</option></select></div>
        <div class="col-md-2"><label class="form-label">المرجع</label><input class="form-control" /></div>
        <div class="col-md-2"><label class="form-label">التوزيع</label><select class="form-select"><option>FIFO تلقائي</option><option>توزيع يدوي</option></select></div>
    </div>
    <div class="mt-3"><button class="btn btn-primary">إضافة دفعة</button></div>
</div></div>
<div class="alert alert-info">مثال: إجمالي الدفعات اليوم @Iqd(350000m)</div>
