@page
@using System.Globalization
@{
    ViewData["Title"] = "كشف حساب مندوب التسليم";
    var iqd = CultureInfo.GetCultureInfo("ar-IQ");
    string Iqd(decimal value) => string.Format(iqd, "{0:C}", value);
}

<h2 class="mb-3">كشف حساب مندوب التسليم</h2>
<div class="form-check form-switch mb-2">
    <input class="form-check-input" type="checkbox" id="unsettledOnly" checked>
    <label class="form-check-label" for="unsettledOnly">غير محاسب فقط</label>
</div>
<div class="row g-2 mb-3">
    <div class="col-md-3"><div class="alert alert-secondary mb-0">إجمالي قيمة الطلبات: <strong>@Iqd(820000m)</strong></div></div>
    <div class="col-md-3"><div class="alert alert-info mb-0">إجمالي التوصيل: <strong>@Iqd(46000m)</strong></div></div>
    <div class="col-md-3"><div class="alert alert-primary mb-0">أجور المندوب: <strong>@Iqd(28000m)</strong></div></div>
    <div class="col-md-3"><div class="alert alert-warning mb-0">غير محاسب: <strong>@Iqd(210000m)</strong></div></div>
</div>
<div class="card shadow-sm">
    <div class="card-body">
        <table class="table table-striped table-sm">
            <thead><tr><th>التاريخ</th><th>رقم الطلب</th><th>قيمة التسليم</th><th>رسوم التوصيل</th><th>أجر المندوب</th><th>صافي ربح الشركة</th><th>تمت التسوية</th><th>راجع</th></tr></thead>
            <tbody>
                <tr><td>2026-02-21</td><td>ORD-2003</td><td>@Iqd(65000m)</td><td>@Iqd(4000m)</td><td>@Iqd(2500m)</td><td>@Iqd(1500m)</td><td>لا</td><td>نعم</td></tr>
            </tbody>
        </table>
        <nav><ul class="pagination pagination-sm"><li class="page-item disabled"><a class="page-link">السابق</a></li><li class="page-item active"><a class="page-link">1</a></li><li class="page-item"><a class="page-link">2</a></li><li class="page-item"><a class="page-link">التالي</a></li></ul></nav>
    </div>
</div>
