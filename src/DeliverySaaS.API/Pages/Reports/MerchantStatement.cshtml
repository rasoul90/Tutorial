@page
@using System.Globalization
@{
    ViewData["Title"] = "كشف حساب تاجر";
    var iqd = CultureInfo.GetCultureInfo("ar-IQ");
    string Iqd(decimal value) => string.Format(iqd, "{0:C}", value);
}

<h2 class="mb-3">كشف حساب تاجر</h2>
<ul class="nav nav-tabs mb-3">
    <li class="nav-item"><a class="nav-link active" href="#">الحركات</a></li>
    <li class="nav-item"><a class="nav-link" href="#">الطلبات</a></li>
    <li class="nav-item"><a class="nav-link" href="#">الدفعات</a></li>
</ul>
<div class="row g-2 mb-3">
