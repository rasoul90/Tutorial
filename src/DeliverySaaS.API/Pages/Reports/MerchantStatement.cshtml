<nav><ul class="pagination pagination-sm"><li class="page-item disabled"><a class="page-link">السابق</a></li><li class="page-item active"><a class="page-link">1</a></li><li class="page-item"><a class="page-link">التالي</a></li></ul></nav>
</div></div>
