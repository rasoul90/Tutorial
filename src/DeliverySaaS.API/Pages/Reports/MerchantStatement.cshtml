@page
@using System.Globalization
@{
    ViewData["Title"] = "كشف حساب تاجر";
    var iqd = CultureInfo.GetCultureInfo("ar-IQ");
    string Iqd(decimal value) => string.Format(iqd, "{0:C}", value);
}

<h2 class="mb-3">كشف حساب تاجر</h2>
<div class="form-check form-switch mb-2">
    <input class="form-check-input" type="checkbox" id="readyOnly" checked>
    <label class="form-check-label" for="readyOnly">جاهز للتحاسب فقط</label>
</div>
<div class="row g-2 mb-3">
    <div class="col-md-4"><div class="alert alert-secondary mb-0">إجمالي المستحق: <strong>@Iqd(450000m)</strong></div></div>
    <div class="col-md-4"><div class="alert alert-success mb-0">محوّل للتاجر: <strong>@Iqd(180000m)</strong></div></div>
    <div class="col-md-4"><div class="alert alert-warning mb-0">قيد الجاهزية: <strong>@Iqd(270000m)</strong></div></div>
</div>
<div class="card shadow-sm">
    <div class="card-body">
        <table class="table table-striped table-sm">
            <thead><tr><th>التاريخ</th><th>رقم الطلب</th><th>العميل</th><th>المحافظة</th><th>الحجم</th><th>القيمة</th><th>التوصيل</th><th>مستحق التاجر</th><th>تسوية المندوب</th><th>تسوية التاجر</th><th>راجع</th><th>ملاحظات</th></tr></thead>
            <tbody>
                <tr><td>2026-02-21</td><td>ORD-1001</td><td>حسن كريم</td><td>بغداد</td><td>Size1</td><td>@Iqd(100000m)</td><td>@Iqd(5000m)</td><td>@Iqd(95000m)</td><td>نعم</td><td>لا</td><td>لا</td><td>-</td></tr>
            </tbody>
        </table>
        <nav><ul class="pagination pagination-sm"><li class="page-item disabled"><a class="page-link">السابق</a></li><li class="page-item active"><a class="page-link">1</a></li><li class="page-item"><a class="page-link">2</a></li><li class="page-item"><a class="page-link">التالي</a></li></ul></nav>
    </div>
</div>
