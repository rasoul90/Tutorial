@model Rasad.Web.Models.DirectorateFormViewModel

<h1 class="h4 mb-3">@SharedLocalizer["CreateNewLabel"]</h1>

<form asp-action="Create" method="post" class="card shadow-sm border-0">
    <div class="card-body">
        <div class="mb-3">
            <label asp-for="MinistryId" class="form-label"></label>
            <select asp-for="MinistryId" class="form-select" asp-items="ViewBag.MinistryId"></select>
            <span asp-validation-for="MinistryId" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="NameAr" class="form-label"></label>
            <input asp-for="NameAr" class="form-control" />
            <span asp-validation-for="NameAr" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">@SharedLocalizer["SaveLabel"]</button>
        <a class="btn btn-outline-secondary" asp-action="Index">@SharedLocalizer["BackLabel"]</a>
    </div>
</form>
