@model Rasad.Web.Models.MinistryDataWindowFormViewModel

<h1 class="h4 mb-3">@SharedLocalizer["CreateNewLabel"]</h1>

<form asp-action="Create" method="post" class="card shadow-sm border-0">
    <div class="card-body">
        <div class="mb-3">
            <label asp-for="MinistryId" class="form-label"></label>
            <select asp-for="MinistryId" class="form-select" asp-items="ViewBag.MinistryId"></select>
            <span asp-validation-for="MinistryId" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="StartAt" class="form-label"></label>
            <input asp-for="StartAt" class="form-control" type="datetime-local" />
            <span asp-validation-for="StartAt" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="EndAt" class="form-label"></label>
            <input asp-for="EndAt" class="form-control" type="datetime-local" />
            <span asp-validation-for="EndAt" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="AfterCloseMessageAr" class="form-label"></label>
            <textarea asp-for="AfterCloseMessageAr" class="form-control" rows="2"></textarea>
        </div>
        <div class="form-check mb-3">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label"></label>
        </div>
        <button type="submit" class="btn btn-primary">@SharedLocalizer["SaveLabel"]</button>
        <a class="btn btn-outline-secondary" asp-action="Index">@SharedLocalizer["BackLabel"]</a>
    </div>
</form>
