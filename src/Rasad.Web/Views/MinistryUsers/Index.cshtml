@model IReadOnlyList<Rasad.Web.Models.Users.MinistryUserListItemViewModel>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4">@SharedLocalizer["MinistryUsersTitle"]</h1>
    <a class="btn btn-primary" asp-action="Create">@SharedLocalizer["CreateNewLabel"]</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">@SharedLocalizer["NoRecordsLabel"]</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>@SharedLocalizer["UserNameLabel"]</th>
                    <th>@SharedLocalizer["EmailLabel"]</th>
                    <th>@SharedLocalizer["MinistryLabel"]</th>
                    <th>@SharedLocalizer["DirectorateLabel"]</th>
                    <th>@SharedLocalizer["DepartmentLabel"]</th>
                    <th>@SharedLocalizer["SectionLabel"]</th>
                    <th>@SharedLocalizer["UnitLabel"]</th>
                    <th>@SharedLocalizer["CanImportExcelLabel"]</th>
                    <th>@SharedLocalizer["CanExportExcelLabel"]</th>
                    <th>@SharedLocalizer["CanViewNationalIdFullLabel"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.UserName</td>
                        <td>@item.Email</td>
                        <td>@item.MinistryName</td>
                        <td>@item.DirectorateName</td>
                        <td>@item.DepartmentName</td>
                        <td>@item.SectionName</td>
                        <td>@item.UnitName</td>
                        <td>@(item.CanImportExcel ? "نعم" : "لا")</td>
                        <td>@(item.CanExportExcel ? "نعم" : "لا")</td>
                        <td>@(item.CanViewNationalIdFull ? "نعم" : "لا")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
