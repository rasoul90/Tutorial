@model Rasad.Domain.Entities.Section

<h1 class="h4 mb-3">@SharedLocalizer["ConfirmDeleteTitle"]</h1>

@if (TempData["ErrorMessage"] is string message)
{
    <div class="alert alert-danger">@message</div>
}

<div class="card shadow-sm border-0">
    <div class="card-body">
        <p class="mb-3">@SharedLocalizer["ConfirmDeleteMessage"]</p>
        <dl class="row">
            <dt class="col-sm-3">@SharedLocalizer["SectionNameLabel"]</dt>
            <dd class="col-sm-9">@Model.NameAr</dd>
            <dt class="col-sm-3">@SharedLocalizer["DepartmentLabel"]</dt>
            <dd class="col-sm-9">@Model.Department?.NameAr</dd>
        </dl>
        <form asp-action="DeleteConfirmed" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-danger">@SharedLocalizer["DeleteConfirmButton"]</button>
            <a class="btn btn-outline-secondary" asp-action="Index" asp-route-departmentId="@Model.DepartmentId">@SharedLocalizer["BackLabel"]</a>
        </form>
    </div>
</div>
