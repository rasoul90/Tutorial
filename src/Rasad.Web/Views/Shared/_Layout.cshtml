<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@SharedLocalizer["AppName"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" integrity="sha384-LbZ3W3R9Z6kQb4URy4pbO5ra0l3QtaiZmm6Ac1T/RNjYOXdd86iRVlGKWx1B8r2x" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header class="border-bottom bg-white">
        <nav class="navbar navbar-expand-lg">
            <div class="container">
                <span class="navbar-brand fw-bold">@SharedLocalizer["AppName"]</span>
            </div>
        </nav>
    </header>
    <main class="container py-4">
        @RenderBody()
    </main>
    <footer class="border-top py-3">
        <div class="container text-center text-muted">
            @SharedLocalizer["FooterText"]
        </div>
    </footer>
</body>
</html>
