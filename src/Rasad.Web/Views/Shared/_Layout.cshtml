<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@SharedLocalizer["AppName"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" integrity="sha384-LbZ3W3R9Z6kQb4URy4pbO5ra0l3QtaiZmm6Ac1T/RNjYOXdd86iRVlGKWx1B8r2x" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header class="border-bottom bg-white">
        <nav class="navbar navbar-expand-lg">
            <div class="container">
                <span class="navbar-brand fw-bold">@SharedLocalizer["AppName"]</span>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="تنقل">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        @if (User.Identity?.IsAuthenticated == true && User.IsInRole("SuperAdmin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Ministries" asp-action="Index">@SharedLocalizer["MinistriesLabel"]</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Directorates" asp-action="Index">@SharedLocalizer["DirectoratesLabel"]</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Departments" asp-action="Index">@SharedLocalizer["DepartmentsLabel"]</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Sections" asp-action="Index">@SharedLocalizer["SectionsLabel"]</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Units" asp-action="Index">@SharedLocalizer["UnitsLabel"]</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="MinistryDataWindows" asp-action="Index">@SharedLocalizer["DataWindowsLabel"]</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Dashboard" asp-action="Index">@SharedLocalizer["DashboardLabel"]</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Reports" asp-action="Unverified">@SharedLocalizer["ReportsTitle"]</a>
                            </li>
                        }
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Employees" asp-action="Index">@SharedLocalizer["EmployeesTitle"]</a>
                            </li>
                        }
                        @if (User.Identity?.IsAuthenticated == true && User.IsInRole("MinistryAdmin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="MinistryUsers" asp-action="Index">@SharedLocalizer["MinistryUsersTitle"]</a>
                            </li>
                        }
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-primary btn-sm">@SharedLocalizer["LogoutLabel"]</button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Login">@SharedLocalizer["LoginLabel"]</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <main class="container py-4">
        @RenderBody()
    </main>
    <footer class="border-top py-3">
        <div class="container text-center text-muted">
            @SharedLocalizer["FooterText"]
        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
</body>
</html>
