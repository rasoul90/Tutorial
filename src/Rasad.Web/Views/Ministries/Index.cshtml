@model IReadOnlyList<Rasad.Domain.Entities.Ministry>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4">@SharedLocalizer["MinistriesTitle"]</h1>
    <a class="btn btn-primary" asp-action="Create">@SharedLocalizer["CreateNewLabel"]</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-sm-6 col-md-4">
        <input name="search" value="@ViewBag.Search" class="form-control" placeholder="@SharedLocalizer["SearchLabel"]" />
    </div>
    <div class="col-sm-6 col-md-2">
        <button type="submit" class="btn btn-outline-primary w-100">@SharedLocalizer["FilterLabel"]</button>
    </div>
</form>

@if (Model.Count == 0)
{
    <div class="alert alert-info">@SharedLocalizer["NoRecordsLabel"]</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>@SharedLocalizer["MinistryNameLabel"]</th>
                    <th>@SharedLocalizer["MinistryCodeLabel"]</th>
                    <th>@SharedLocalizer["IsActiveLabel"]</th>
                    <th class="text-end">@SharedLocalizer["ActionsLabel"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.NameAr</td>
                        <td>@item.Code</td>
                        <td>@(item.IsActive ? "نعم" : "لا")</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.Id">@SharedLocalizer["EditLabel"]</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">@SharedLocalizer["DeleteLabel"]</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <nav class="d-flex justify-content-center">
        <ul class="pagination">
            @for (var i = 1; i <= (int)ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == (int)ViewBag.Page ? "active" : "")">
                    <a class="page-link" href="?search=@ViewBag.Search&page=@i">@i</a>
                </li>
            }
        </ul>
    </nav>
}
