@model Rasad.Web.Models.MinistryFormViewModel

<h1 class="h4 mb-3">@SharedLocalizer["EditLabel"]</h1>

<form asp-action="Edit" method="post" class="card shadow-sm border-0">
    <input type="hidden" asp-for="Id" />
    <div class="card-body">
        <div class="mb-3">
            <label asp-for="NameAr" class="form-label"></label>
            <input asp-for="NameAr" class="form-control" />
            <span asp-validation-for="NameAr" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Code" class="form-label"></label>
            <input asp-for="Code" class="form-control" />
            <span asp-validation-for="Code" class="text-danger"></span>
        </div>
        <div class="form-check mb-3">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label"></label>
        </div>
        <button type="submit" class="btn btn-primary">@SharedLocalizer["SaveLabel"]</button>
        <a class="btn btn-outline-secondary" asp-action="Index">@SharedLocalizer["BackLabel"]</a>
    </div>
</form>
