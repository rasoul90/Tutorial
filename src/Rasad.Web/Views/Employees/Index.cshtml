@model IReadOnlyList<Rasad.Web.Models.Employees.EmployeeListItemViewModel>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4">@SharedLocalizer["EmployeesTitle"]</h1>
    @if ((bool?)ViewBag.IsWindowOpen == true || User.IsInRole("SuperAdmin"))
    {
        <a class="btn btn-primary" asp-action="Create">@SharedLocalizer["CreateNewLabel"]</a>
    }
</div>

@if (TempData["ErrorMessage"] is string message)
{
    <div class="alert alert-warning">@message</div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-info">@SharedLocalizer["NoRecordsLabel"]</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>@SharedLocalizer["EmployeeFullNameLabel"]</th>
                    <th>@SharedLocalizer["JobNumberLabel"]</th>
                    <th>@SharedLocalizer["NationalIdLabel"]</th>
                    <th>@SharedLocalizer["MinistryLabel"]</th>
                    <th>@SharedLocalizer["DirectorateLabel"]</th>
                    <th>@SharedLocalizer["DepartmentLabel"]</th>
                    <th>@SharedLocalizer["SectionLabel"]</th>
                    <th>@SharedLocalizer["UnitLabel"]</th>
                    <th class="text-end">@SharedLocalizer["ActionsLabel"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.FullName</td>
                        <td>@item.JobNumber</td>
                        <td>@item.NationalIdDisplay</td>
                        <td>@item.MinistryName</td>
                        <td>@item.DirectorateName</td>
                        <td>@item.DepartmentName</td>
                        <td>@item.SectionName</td>
                        <td>@item.UnitName</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.Id">@SharedLocalizer["EditLabel"]</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">@SharedLocalizer["DeleteLabel"]</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
