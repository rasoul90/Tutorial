@model Rasad.Web.Models.Employees.EmployeeFormViewModel

<h1 class="h4 mb-3">@SharedLocalizer["EditLabel"]</h1>

<form asp-action="Edit" method="post" class="card shadow-sm border-0">
    <input type="hidden" asp-for="Id" />
    <div class="card-body">
        <div class="mb-3">
            <label asp-for="FullName" class="form-label"></label>
            <input asp-for="FullName" class="form-control" />
            <span asp-validation-for="FullName" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="JobNumber" class="form-label"></label>
            <input asp-for="JobNumber" class="form-control" />
            <span asp-validation-for="JobNumber" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="NationalId" class="form-label"></label>
            <input asp-for="NationalId" class="form-control" />
            <span asp-validation-for="NationalId" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="MinistryId" class="form-label"></label>
            <select asp-for="MinistryId" class="form-select" asp-items="ViewBag.MinistryId"></select>
            <span asp-validation-for="MinistryId" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="DirectorateId" class="form-label"></label>
            <select asp-for="DirectorateId" class="form-select" asp-items="ViewBag.DirectorateId"></select>
            <span asp-validation-for="DirectorateId" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="DepartmentId" class="form-label"></label>
            <select asp-for="DepartmentId" class="form-select" asp-items="ViewBag.DepartmentId"></select>
            <span asp-validation-for="DepartmentId" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="SectionId" class="form-label"></label>
            <select asp-for="SectionId" class="form-select" asp-items="ViewBag.SectionId"></select>
            <span asp-validation-for="SectionId" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="UnitId" class="form-label"></label>
            <select asp-for="UnitId" class="form-select" asp-items="ViewBag.UnitId"></select>
            <span asp-validation-for="UnitId" class="text-danger"></span>
        </div>
        <div class="text-danger mb-3">
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        </div>
        <button type="submit" class="btn btn-primary">@SharedLocalizer["SaveLabel"]</button>
        <a class="btn btn-outline-secondary" asp-action="Index">@SharedLocalizer["BackLabel"]</a>
    </div>
</form>
