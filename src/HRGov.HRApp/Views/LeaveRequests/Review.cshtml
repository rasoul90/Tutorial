@model LeaveRequest
@{
    ViewData["Title"] = "مراجعة طلب إجازة";
}

<h1>مراجعة طلب إجازة</h1>

<dl class="row">
    <dt class="col-sm-3">الموظف</dt>
    <dd class="col-sm-9">@Model.Employee?.FullName</dd>
    <dt class="col-sm-3">الفترة</dt>
    <dd class="col-sm-9">@Model.StartDate.ToString("yyyy-MM-dd") - @Model.EndDate.ToString("yyyy-MM-dd")</dd>
    <dt class="col-sm-3">نوع الإجازة</dt>
    <dd class="col-sm-9">@Model.LeaveType</dd>
    <dt class="col-sm-3">الملاحظات</dt>
    <dd class="col-sm-9">@Model.Notes</dd>
</dl>

<form asp-action="Review" method="post">
    <input type="hidden" name="id" value="@Model.Id" />
    <div class="row g-3">
        <div class="col-md-4">
            <label class="form-label" for="status">الحالة</label>
            <select class="form-select" name="status" asp-items="Html.GetEnumSelectList<LeaveStatus>()"></select>
        </div>
        <div class="col-md-4">
            <label class="form-label" for="approvedById">المصادق</label>
            <select class="form-select" name="approvedById" asp-items="ViewBag.Employees">
                <option value="">اختر الموظف المخول</option>
            </select>
        </div>
        <div class="col-12">
            <button class="btn btn-primary" type="submit">حفظ</button>
            <a class="btn btn-secondary" asp-action="Index">عودة</a>
        </div>
    </div>
</form>
