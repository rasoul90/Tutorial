<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - نظام الموارد البشرية الحكومي</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container-fluid">
            <a class="navbar-brand" asp-controller="Dashboard" asp-action="Index">نظام الموارد البشرية</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item"><a class="nav-link" asp-controller="Dashboard" asp-action="Index">الرئيسية</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Employees" asp-action="Index">الموظفون</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Departments" asp-action="Index">الدوائر</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="LeaveRequests" asp-action="Index">الإجازات</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Payroll" asp-action="Index">الرواتب</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="TrainingSessions" asp-action="Index">التدريب</a></li>
                </ul>
            </div>
        </div>
    </nav>
    <div class="container mt-4">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success show">@TempData["Success"]</div>
        }
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
