@model PayrollRecord
@{
    ViewData["Title"] = "إضافة سجل رواتب";
}

<h1>إضافة سجل رواتب</h1>

<form asp-action="Create" method="post" class="row g-3">
    <div class="col-md-6">
        <label asp-for="EmployeeId" class="form-label"></label>
        <select asp-for="EmployeeId" class="form-select" asp-items="ViewBag.Employees"></select>
    </div>
    <div class="col-md-6">
        <label asp-for="PayrollDate" class="form-label"></label>
        <input asp-for="PayrollDate" class="form-control" type="date" />
    </div>
    <div class="col-md-4">
        <label asp-for="BasicSalary" class="form-label"></label>
        <input asp-for="BasicSalary" class="form-control" type="number" step="0.01" />
    </div>
    <div class="col-md-4">
        <label asp-for="Allowances" class="form-label"></label>
        <input asp-for="Allowances" class="form-control" type="number" step="0.01" />
    </div>
    <div class="col-md-4">
        <label asp-for="Deductions" class="form-label"></label>
        <input asp-for="Deductions" class="form-control" type="number" step="0.01" />
    </div>
    <div class="col-12">
        <button class="btn btn-primary" type="submit">حفظ</button>
        <a asp-action="Index" class="btn btn-secondary">إلغاء</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
