@model IEnumerable<Department>
@{
    ViewData["Title"] = "الدوائر";
}

<h1>الدوائر الحكومية</h1>
<a class="btn btn-primary mb-3" asp-action="Create">إضافة دائرة</a>
<table class="table table-striped">
    <thead>
        <tr>
            <th>الاسم</th>
            <th>الوصف</th>
            <th>عدد الموظفين</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var dept in Model)
        {
            <tr>
                <td>@dept.Name</td>
                <td>@dept.Description</td>
                <td>@dept.Employees.Count</td>
                <td>
                    <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@dept.Id">تعديل</a>
                    <form asp-action="Delete" asp-route-id="@dept.Id" method="post" class="d-inline" onsubmit="return confirm('تأكيد الحذف؟');">
                        <button class="btn btn-sm btn-danger" type="submit">حذف</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
